(defcfg
	input (device-file "/dev/input/by-id/usb-Keychron_Keychron_C1-event-kbd")
	output (uinput-sink "Keychron C1")

	fallthrough true
	allow-cmd true
)


(defalias
	ce (tap-hold-next-release 175 esc lctl)
)

(defsrc
	esc  f1  f2  f3  f4  f5  f6  f7  f8  f9  f10 f11 f12        prnt
	grv  1   2   3   4   5   6   7   8   9   0   -   =   bspc   ins  home pgup
	tab  q   w   e   r   t   y   u   i   o   p   [   ]   \      del  end  pgdn
	caps a   s   d   f   g   h   j   k   l   ;   '     ret
	lsft     z   x   c   v   b   n   m   ,   .   /   rsft             up
	lctl lmet lalt           spc            ralt rmet fn rctl   left down rght
)

(deflayer enhancements
	esc  f1  f2  f3  f4  f5  f6  f7  f8  f9  f10 f11 f12        prnt
	grv  1   2   3   4   5   6   7   8   9   0   -   =   bspc   ins  home pgup
	tab  q   w   e   r   t   y   u   i   o   p   [   ]   \      del  end  pgdn
	@ce  a   s   d   f   g   h   j   k   l   ;   '     ret
	lsft     z   x   c   v   b   n   m   ,   .   /   rsft             up
	lctl lmet lalt           spc            ralt rmet fn rctl   left down rght
)
